# Application
APP_NAME=Dello API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Base de données
POSTGRES_USER=dello
POSTGRES_PASSWORD=
POSTGRES_DB=dello
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT (générer avec la commande du README)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# HMAC documents (clé DIFFÉRENTE du JWT)
DOCUMENT_HMAC_KEY=

# CORS (format JSON)
CORS_ORIGINS=[]

# Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# Rate limiting
AUTH_RATE_LIMIT=5/minute