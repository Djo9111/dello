# Application
APP_NAME=Dello API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Base de données
POSTGRES_USER=dello
POSTGRES_PASSWORD=
POSTGRES_DB=dello
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT (générer avec la commande du README)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# HMAC documents (clé DIFFÉRENTE du JWT)
DOCUMENT_HMAC_KEY=

# CORS (format JSON)
CORS_ORIGINS=[]

# Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# Rate limiting
AUTH_RATE_LIMIT=5/minute
REPORT_CREATE_RATE_LIMIT=20/hour

# Vérification du numéro (console : le code s'affiche dans les logs)
OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=3
SMS_PROVIDER=console
PUSH_PROVIDER=console
PUBLIC_BASE_URL=http://localhost:8000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=sn.dello.app